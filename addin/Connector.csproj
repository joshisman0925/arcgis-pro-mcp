<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProConnector</AssemblyName>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/addin</PathMap>
    <!-- Release packages must not retain a developer's PDB/source path. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <ProRoot Condition="'$(ProRoot)' == ''">C:\Program Files\ArcGIS\Pro</ProRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ArcGIS.Core"><HintPath>$(ProRoot)\bin\ArcGIS.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Framework"><HintPath>$(ProRoot)\bin\ArcGIS.Desktop.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Core"><HintPath>$(ProRoot)\bin\Extensions\Core\ArcGIS.Desktop.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Mapping"><HintPath>$(ProRoot)\bin\Extensions\Mapping\ArcGIS.Desktop.Mapping.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Editing"><HintPath>$(ProRoot)\bin\Extensions\Editing\ArcGIS.Desktop.Editing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Layouts"><HintPath>$(ProRoot)\bin\Extensions\Layout\ArcGIS.Desktop.Layouts.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Catalog"><HintPath>$(ProRoot)\bin\Extensions\Catalog\ArcGIS.Desktop.Catalog.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
